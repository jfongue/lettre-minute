{
  "name": "lettre-minute",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "scripts/test-db.sh",
    "render:invite": "node --experimental-strip-types scripts/render-invite-art.ts",
    "render:achievements": "node --experimental-strip-types scripts/render-achievements.ts",
    "group:invites": "node --experimental-strip-types scripts/group-invites.ts",
    "debug:recent": "node --experimental-strip-types scripts/debug-recent.ts",
    "import:words": "node --experimental-strip-types scripts/import-words.ts",
    "seed:moderation": "node --experimental-strip-types scripts/moderation-reserve.ts",
    "ban:sync": "node --experimental-strip-types scripts/ban-sync.ts",
    "analytics": "node --experimental-strip-types scripts/analytics.ts",
    "import:names": "node --experimental-strip-types scripts/first-names.ts",
    "words:drift": "node --experimental-strip-types scripts/words-drift.ts",
    "web:publish": "scripts/publish-web.sh",
    "crazygames:build": "node --experimental-strip-types scripts/crazygames-build.ts",
    "crazygames:dev": "vite --mode crazygames --open /crazygames.html",
    "crazygames:harness": "node crazygames/harness.mjs",
    "crazygames:check": "node crazygames/check.mjs",
    "crazygames:shots": "node --experimental-strip-types scripts/crazygames-shots.ts",
    "crazygames:video": "npm --prefix crazygames/video install && node crazygames/video/capture.mjs && node crazygames/video/render.mjs",
    "reddit:build": "npm --prefix reddit run build",
    "reddit:check": "npm --prefix reddit run check",
    "reddit:harness": "npm --prefix reddit run harness",
    "reddit:playtest": "npm --prefix reddit run dev",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:release": "npm run android:bundle && node --experimental-strip-types scripts/play-release.ts",
    "android:listing": "node --experimental-strip-types scripts/play-listing.ts",
    "check": "oxlint && tsc -b && vitest run && npm run check:platforms",
    "check:platforms": "node --experimental-strip-types scripts/check-platforms.ts",
    "check:full": "npm run check && npm run test:db",
    "fuzz": "FUZZ_SEED=${FUZZ_SEED:-$(node -p \"Math.floor(Math.random()*2**32)\")} FUZZ_RUNS=${FUZZ_RUNS:-400} sh -c 'echo FUZZ_SEED=$FUZZ_SEED; vitest run src/state/fuzz.test.ts src/domain/profile.fuzz.test.ts src/domain/challenge.fuzz.test.ts'"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-app-update": "^8.0.5",
    "@capgo/capacitor-social-login": "^8.5.11",
    "@fontsource-variable/jost": "^5.3.0",
    "@supabase/auth-js": "^2.117.0",
    "@supabase/postgrest-js": "^2.117.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
