# Sans ces deux variables, le jeu tourne entièrement en local : scores, niveaux
# et mots proposés restent dans le navigateur.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Adresse publique de la politique de confidentialité (public/confidentialite.html
# une fois le site en ligne). Obligatoire pour le build des stores : dans
# l'application, un lien relatif ferait quitter le jeu à la vue.
VITE_PRIVACY_URL=

# Bloc d'annonces interstitiel AdMob (ca-app-pub-…/…). Vide, le jeu montre les
# pubs de test de Google, qui ne rapportent rien. L'identifiant de l'app AdMob
# (ca-app-pub-…~…) va, lui, dans android/gradle.properties sous admobAppId.
VITE_ADMOB_INTERSTITIAL_ID=
