# Sans ces deux variables, le jeu tourne entièrement en local : scores, niveaux
# et mots proposés restent dans le navigateur.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Adresse publique de la politique de confidentialité (public/confidentialite.html
# une fois le site en ligne). Obligatoire pour le build des stores : dans
# l'application, un lien relatif ferait quitter le jeu à la vue.
VITE_PRIVACY_URL=

# Bloc d'annonces interstitiel AdMob (ca-app-pub-…/…). Vide, le jeu montre les
# pubs de test de Google, qui ne rapportent rien. L'identifiant de l'app AdMob
# (ca-app-pub-…~…) va, lui, dans android/gradle.properties sous admobAppId.
VITE_ADMOB_INTERSTITIAL_ID=

# Notifications push des défis (Android). À ne mettre à « true » qu'une fois
# android/app/google-services.json en place : sans lui, l'inscription au push
# fait planter l'app au lancement. Voir docs/notifications-push.md.
VITE_PUSH_ENABLED=

# « Continuer avec Google » (application seulement) : l'identifiant du client
# OAuth *Web* de Google Cloud (…apps.googleusercontent.com), le même que celui
# saisi dans Supabase > Authentication > Providers > Google. Vide, pas de bouton.
# Voir supabase/README.md, section Comptes.
VITE_GOOGLE_WEB_CLIENT_ID=

# Test fermé Android : l'adresse du groupe Google public que la Play Console
# prend pour liste de testeurs (https://groups.google.com/g/…). La page
# d'invitation (invite.html) y envoie un ami sur Android. Vide, elle ne
# propose que la version web.
VITE_TESTER_GROUP_URL=
